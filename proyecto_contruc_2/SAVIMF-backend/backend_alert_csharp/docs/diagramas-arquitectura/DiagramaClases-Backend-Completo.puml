package "Infrastructure Layer - Repositories" <<Rectangle>> {
    
    interface IAlertaRepositoryFirestore <<Interface>> REPO_COLOR {
        + Task<AlertaDto> CrearAsync(Dictionary<string, object> data)
        + Task<AlertaDto?> BuscarPorIdAsync(string id)
        + Task<List<AlertaDto>> BuscarPorDevEUIAsync(string devEUI, DateTime desde)
        + Task<List<AlertaDto>> ObtenerActivasAsync()
        + Task ActualizarEstadoAsync(string id, string estado, string? patrulleroId)
        + Task ActualizarAsync(string id, Dictionary<string, object> updates)
        + Task MarcarComoVencidaAsync(string id)
    }
    
    class AlertaRepositoryFirestore <<Repository>> REPO_COLOR {
        - FirestoreDb _firestore
        - ILogger<AlertaRepositoryFirestore> _logger
        - const string COLLECTION_NAME = "alertas"
        --
        + AlertaRepositoryFirestore(FirestoreDb db, ILogger logger)
        + Task<AlertaDto> CrearAsync(Dictionary<string, object> data)
        + Task<AlertaDto?> BuscarPorIdAsync(string id)
        + Task<List<AlertaDto>> BuscarPorDevEUIAsync(string devEUI, DateTime desde)
        + Task<List<AlertaDto>> ObtenerActivasAsync()
        + Task ActualizarEstadoAsync(string id, string estado, string? patrulleroId)
        + Task ActualizarAsync(string id, Dictionary<string, object> updates)
        + Task MarcarComoVencidaAsync(string id)
        - AlertaDto MapearDesdeFirestore(DocumentSnapshot doc)
    }
    
    interface IUserRepositoryFirestore <<Interface>> REPO_COLOR {
        + Task<UsuarioDto> CrearAsync(string uid, Dictionary<string, object> data)
        + Task<UsuarioDto?> BuscarPorUidAsync(string uid)
        + Task<UsuarioDto?> BuscarPorEmailAsync(string email)
        + Task<List<UsuarioDto>> ObtenerTodosAsync(string? rolFiltro, bool? activoFiltro)
        + Task ActualizarAsync(string uid, Dictionary<string, object> updates)
        + Task AgregarFCMTokenAsync(string uid, string token)
        + Task RemoverFCMTokenAsync(string uid, string token)
        + Task<List<string>> ObtenerFCMTokensPorRolAsync(string rol)
    }
    
    class UserRepositoryFirestore <<Repository>> REPO_COLOR {
        - FirestoreDb _firestore
        - ILogger<UserRepositoryFirestore> _logger
        - const string COLLECTION_NAME = "usuarios"
        --
        + UserRepositoryFirestore(FirestoreDb db, ILogger logger)
        + Task<UsuarioDto> CrearAsync(string uid, Dictionary<string, object> data)
        + Task<UsuarioDto?> BuscarPorUidAsync(string uid)
        + Task<UsuarioDto?> BuscarPorEmailAsync(string email)
        + Task<List<UsuarioDto>> ObtenerTodosAsync(string? rolFiltro, bool? activoFiltro)
        + Task ActualizarAsync(string uid, Dictionary<string, object> updates)
        + Task AgregarFCMTokenAsync(string uid, string token)
        + Task RemoverFCMTokenAsync(string uid, string token)
        + Task<List<string>> ObtenerFCMTokensPorRolAsync(string rol)
        - UsuarioDto MapearDesdeFirestore(DocumentSnapshot doc)
    }
    
    interface IAtestadoPolicialRepositoryFirestore <<Interface>> REPO_COLOR {
        + Task<AtestadoPolicialDto> CrearAsync(Dictionary<string, object> data)
        + Task<AtestadoPolicialDto?> BuscarPorIdAsync(string id)
        + Task<AtestadoPolicialDto?> BuscarPorAlertaIdAsync(string alertaId)
        + Task<List<AtestadoPolicialDto>> ConsultarAsync(AtestadoQueryDto query)
        + Task<byte[]> GenerarPDFAsync(string id)
    }
    
    class AtestadoPolicialRepositoryFirestore <<Repository>> REPO_COLOR {
        - FirestoreDb _firestore
        - ILogger<AtestadoPolicialRepositoryFirestore> _logger
        - const string COLLECTION_NAME = "atestados_policiales"
        --
        + AtestadoPolicialRepositoryFirestore(FirestoreDb db, ILogger logger)
        + Task<AtestadoPolicialDto> CrearAsync(Dictionary<string, object> data)
        + Task<AtestadoPolicialDto?> BuscarPorIdAsync(string id)
        + Task<AtestadoPolicialDto?> BuscarPorAlertaIdAsync(string alertaId)
        + Task<List<AtestadoPolicialDto>> ConsultarAsync(AtestadoQueryDto query)
        + Task<byte[]> GenerarPDFAsync(string id)
        - AtestadoPolicialDto MapearDesdeFirestore(DocumentSnapshot doc)
        - Query AplicarFiltros(Query query, AtestadoQueryDto filtros)
    }
    
    interface IDispositivoRepositoryFirestore <<Interface>> REPO_COLOR {
        + Task<DispositivoDto> CrearAsync(Dictionary<string, object> data)
        + Task<DispositivoDto?> BuscarPorIdAsync(string id)
        + Task<DispositivoDto?> BuscarPorDevEUIAsync(string devEUI)
        + Task<List<DispositivoDto>> ObtenerTodosAsync()
        + Task ActualizarAsync(string id, Dictionary<string, object> updates)
        + Task ActualizarUltimaActivacionAsync(string devEUI, DateTime fecha)
    }
    
    class DispositivoRepositoryFirestore <<Repository>> REPO_COLOR {
        - FirestoreDb _firestore
        - ILogger<DispositivoRepositoryFirestore> _logger
        - const string COLLECTION_NAME = "dispositivos"
        --
        + DispositivoRepositoryFirestore(FirestoreDb db, ILogger logger)
        + Task<DispositivoDto> CrearAsync(Dictionary<string, object> data)
        + Task<DispositivoDto?> BuscarPorIdAsync(string id)
        + Task<DispositivoDto?> BuscarPorDevEUIAsync(string devEUI)
        + Task<List<DispositivoDto>> ObtenerTodosAsync()
        + Task ActualizarAsync(string id, Dictionary<string, object> updates)
        + Task ActualizarUltimaActivacionAsync(string devEUI, DateTime fecha)
