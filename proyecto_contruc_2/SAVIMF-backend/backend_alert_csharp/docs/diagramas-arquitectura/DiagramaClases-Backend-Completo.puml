    interface IPatrullaRepositoryFirestore <<Interface>> REPO_COLOR {
        + Task ActualizarUbicacionAsync(string patrulleroId, double lat, double lng, DateTime timestamp)
        + Task<UbicacionDto?> ObtenerUbicacionActualAsync(string patrulleroId)
