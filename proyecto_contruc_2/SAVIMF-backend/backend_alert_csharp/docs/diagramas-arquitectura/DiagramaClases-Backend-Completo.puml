@startuml DiagramaClases_Backend_SAVIMF
!define ENTITY_COLOR #E8F5E9
!define USECASE_COLOR #E3F2FD
!define REPO_COLOR #FFF3E0
!define SERVICE_COLOR #F3E5F5
!define CONTROLLER_COLOR #FFEBEE
!define HUB_COLOR #FCE4EC

title Diagrama de Clases - Backend SAVIMF (Clean Architecture)

' =====================================
' CAPA DE DOMINIO - ENTIDADES
' =====================================

package "Domain Layer - Entities" <<Rectangle>> {
    
    class AlertaDto <<Entity>> ENTITY_COLOR {
        + string Id
        + string DevEUI
        + double Latitud
        + double Longitud
        + DateTime FechaHora
        + string Estado
        + string NivelUrgencia
        + int CantidadActivaciones
        + string? PatrulleroId
        + double? DistanciaPatrullero
        + bool Vencida
        + DateTime? FechaVencimiento
        + VictimaDto? Victima
        --
        + AlertaDto()
        + static AlertaDto FromFirestore(DocumentSnapshot doc)
        + Dictionary<string, object> ToFirestore()
    }
    
    class UsuarioDto <<Entity>> ENTITY_COLOR {
        + string Uid
        + string Email
        + string Nombre
        + string Apellido
        + string Dni
        + string Telefono
        + string Role
        + bool Activo
        + List<string> FcmTokens
        + DateTime CreadoEn
        + DateTime ActualizadoEn
        --
        + UsuarioDto()
        + static UsuarioDto FromFirestore(DocumentSnapshot doc)
        + bool TienePermiso(string permiso)
    }
    
    class AtestadoPolicialDto <<Entity>> ENTITY_COLOR {
        + string Id
        + string AlertaId
        + string PatrulleroId
        + DateTime FechaHora
        + UbicacionDto Ubicacion
        + VictimaDto Victima
        + AgresorDto Agresor
        + IncidenteDto Incidente
        + string EstadoVictima
        + List<string> MedidasProteccion
        + DerivacionDto Derivacion
        + string Observaciones
        + List<string> Evidencias
        --
        + AtestadoPolicialDto()
        + Dictionary<string, object> ToFirestore()
    }
    
    class DispositivoDto <<Entity>> ENTITY_COLOR {
        + string Id
        + string DevEUI
        + string AppKey
        + string TTSDeviceId
        + string Nombre
        + string Descripcion
        + UbicacionDto Ubicacion
        + bool Activo
        + DateTime? UltimaActivacion
        + int CantidadAlertas
        + string? VictimaId
        + VictimaDto? VictimaVinculada
        --
        + DispositivoDto()
        + bool EsValidoParaActivacion()
    }
    
    class OpenDataDto <<Entity>> ENTITY_COLOR {
        + string Id
        + DateTime FechaHora
        + double LatitudAnonimizada
        + double LongitudAnonimizada
        + string NivelUrgencia
        + int CantidadActivaciones
        + int? TiempoRespuesta
        + string Estado
        + string Departamento
        + string Provincia
        + string Distrito
        + int Mes
        + int Anio
        + string DiaSemana
        --
        + OpenDataDto()
        + static OpenDataDto Anonimizar(AlertaDto alerta)
    }
    
    class VictimaDto <<ValueObject>> ENTITY_COLOR {
        + string Nombre
        + string Apellido
        + string Dni
        + int Edad
        + string Telefono
        + string RelacionAgresor
    }
    
    class AgresorDto <<ValueObject>> ENTITY_COLOR {
        + string Nombre
        + string Apellido
        + string Dni
        + int Edad
        + string RelacionVictima
    }
    
    class UbicacionDto <<ValueObject>> ENTITY_COLOR {
        + double Latitud
        + double Longitud
        + string? Direccion
        + string? Referencia
    }
    
    class IncidenteDto <<ValueObject>> ENTITY_COLOR {
        + List<string> TiposViolencia
        + string Descripcion
        + bool LesionesVisibles
        + string ArmasUtilizadas
        + bool Testigos
        + int? NumeroTestigos
    }
    
    class DerivacionDto <<ValueObject>> ENTITY_COLOR {
        + bool RequiereAtencionMedica
        + bool RequiereAsistenciaLegal
        + bool RequiereAsistenciaPsicologica
    }
}

' =====================================
' CAPA DE APLICACIÓN - USE CASES
' =====================================

package "Application Layer - Use Cases" <<Rectangle>> {
    
    abstract class BaseUseCase<TRequest, TResponse> <<Abstract>> USECASE_COLOR {
        # ILogger Logger
        --
        + {abstract} Task<TResponse> EjecutarAsync(TRequest request)
        # void LogInfo(string message)
        # void LogError(string message, Exception ex)
    }
    
    class RegistrarAlertaUseCase <<UseCase>> USECASE_COLOR {
        - IAlertaRepositoryFirestore _alertaRepo
        - IDispositivoRepositoryFirestore _dispositivoRepo
        - IHubContext<AlertaHub> _hubContext
        - IFCMService _fcmService
        - ILogger<RegistrarAlertaUseCase> _logger
        --
        + RegistrarAlertaUseCase(deps...)
        + Task<AlertaDto> EjecutarAsync(LorawanWebhookDto webhook)
        - Task<AlertaDto?> BuscarAlertaRecienteAsync(string devEUI, DateTime desde)
        - string CalcularNivelUrgencia(int cantidadActivaciones)
        - Task EnviarNotificacionesAsync(AlertaDto alerta)
        - Task BroadcastSignalRAsync(AlertaDto alerta)
    }
    
    class ActualizarUbicacionPatrullaUseCase <<UseCase>> USECASE_COLOR {
        - IPatrullaRepositoryFirestore _patrullaRepo
        - IHubContext<AlertaHub> _hubContext
        - ILogger<ActualizarUbicacionPatrullaUseCase> _logger
        --
        + ActualizarUbicacionPatrullaUseCase(deps...)
        + Task EjecutarAsync(string patrulleroId, double lat, double lng)
        - Task BroadcastUbicacionAsync(UbicacionDto ubicacion)
    }
    
    class RegistrarUsuarioUseCase <<UseCase>> USECASE_COLOR {
        - IUserRepositoryFirestore _userRepo
        - IFirebaseAuthService _authService
        - ILogger<RegistrarUsuarioUseCase> _logger
        --
        + RegistrarUsuarioUseCase(deps...)
        + Task<UsuarioDto> EjecutarAsync(RegistrarUsuarioRequestDto request)
        - Task<bool> ValidarEmailDisponibleAsync(string email)
        - Task CrearEnFirebaseAuthAsync(string email, string password)
        - Task CrearEnFirestoreAsync(UsuarioDto usuario)
    }
    
    class EditarUsuarioUseCase <<UseCase>> USECASE_COLOR {
        - IUserRepositoryFirestore _userRepo
        - IFirebaseAuthService _authService
        - ILogger<EditarUsuarioUseCase> _logger
        --
        + EditarUsuarioUseCase(deps...)
        + Task<UsuarioDto> EjecutarAsync(string uid, EditarUsuarioRequestDto request)
        - Task ActualizarEnFirebaseAuthAsync(string uid, bool activo)
        - Task ActualizarEnFirestoreAsync(string uid, Dictionary<string, object> updates)
    }
    
    class EliminarUsuarioUseCase <<UseCase>> USECASE_COLOR {
        - IUserRepositoryFirestore _userRepo
        - IFirebaseAuthService _authService
        - ILogger<EliminarUsuarioUseCase> _logger
        --
        + EliminarUsuarioUseCase(deps...)
        + Task EjecutarAsync(string uid)
        - Task DeshabilitarEnFirebaseAuthAsync(string uid)
        - Task MarcarComoEliminadoAsync(string uid)
    }
    
    class LoginUseCase <<UseCase>> USECASE_COLOR {
        - IUserRepositoryFirestore _userRepo
        - IFirebaseAuthService _authService
        - ILogger<LoginUseCase> _logger
        --
        + LoginUseCase(deps...)
        + Task<UsuarioDto?> EjecutarAsync(string firebaseToken)
        - Task<FirebaseToken> VerificarTokenAsync(string token)
        - Task<UsuarioDto?> ObtenerUsuarioPorUidAsync(string uid)
    }
    
    class RegistrarDispositivoTTSUseCase <<UseCase>> USECASE_COLOR {
        - IDispositivoRepositoryFirestore _dispositivoRepo
        - ITTSDeviceService _ttsService
        - ILogger<RegistrarDispositivoTTSUseCase> _logger
        --
        + RegistrarDispositivoTTSUseCase(deps...)
        + Task<DispositivoDto> EjecutarAsync(RegistrarDispositivoRequestDto request)
        - Task<bool> VerificarDispositivoExisteAsync(string devEUI)
        - Task<TTSDeviceDto> CrearEnTTSAsync(DispositivoDto dispositivo)
        - Task GuardarEnFirestoreAsync(DispositivoDto dispositivo)
    }
    
    class ObtenerOpenDataUseCase <<UseCase>> USECASE_COLOR {
        - IOpenDataRepositoryFirestore _openDataRepo
        - ILogger<ObtenerOpenDataUseCase> _logger
        --
        + ObtenerOpenDataUseCase(deps...)
        + Task<OpenDataResponseDto> EjecutarAsync(OpenDataQueryDto query)
        - Task<List<OpenDataDto>> ConsultarDatosAsync(OpenDataQueryDto query)
        - EstadisticasOpenDataDto CalcularEstadisticas(List<OpenDataDto> datos)
    }
    
    class ConsultarAtestadosUseCase <<UseCase>> USECASE_COLOR {
        - IAtestadoPolicialRepositoryFirestore _atestadoRepo
        - IUserRepositoryFirestore _userRepo
        - ILogger<ConsultarAtestadosUseCase> _logger
        --
        + ConsultarAtestadosUseCase(deps...)
        + Task<ConsultarAtestadosResponseDto> EjecutarAsync(AtestadoQueryDto query)
        - Task EnriquecerConDatosPatrulleroAsync(List<AtestadoPolicialDto> atestados)
        - EstadisticasAtestadosDto CalcularEstadisticas(List<AtestadoPolicialDto> atestados)
    }
    
    class GenerarTestsUseCase <<UseCase>> USECASE_COLOR {
        - IAlertaRepositoryFirestore _alertaRepo
        - IUserRepositoryFirestore _userRepo
        - ILogger<GenerarTestsUseCase> _logger
        --
        + GenerarTestsUseCase(deps...)
        + Task EjecutarAsync(int cantidadAlertas, int cantidadUsuarios)
        - AlertaDto GenerarAlertaAleatoria()
        - UsuarioDto GenerarUsuarioAleatorio()
    }
}

