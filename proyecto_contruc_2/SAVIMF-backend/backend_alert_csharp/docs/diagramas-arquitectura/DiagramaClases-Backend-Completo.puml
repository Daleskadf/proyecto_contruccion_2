        + Task<UbicacionDto?> ObtenerUbicacionActualAsync(string patrulleroId)
        + Task<List<PatrullaDto>> ObtenerPatrullasActivasAsync()
    }
    
    interface IOpenDataRepositoryFirestore <<Interface>> REPO_COLOR {
        + Task<List<OpenDataDto>> ObtenerAlertasAnonimadasAsync(OpenDataQueryDto query)
        + Task CrearDesdeAlertaAsync(AlertaDto alerta)
    }
    
    class OpenDataRepositoryFirestore <<Repository>> REPO_COLOR {
        - FirestoreDb _firestore
        - ILogger<OpenDataRepositoryFirestore> _logger
        - const string COLLECTION_NAME = "open_data"
